# ──────────────────────────────────────────────────────────────
# uRent — environment variables
# Copy to .env.local and fill in.
# ──────────────────────────────────────────────────────────────

# Required: Neon Postgres (Vercel Marketplace → "Neon")
DATABASE_URL=

# App URL (for email links). Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Email (Resend — Vercel Marketplace → "Resend")
# Without these, verification/reset/magic-link emails are logged to console (dev fallback).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: Rate-Limit (Upstash Redis — Vercel Marketplace → "Upstash for Redis")
# Without these, rate-limiting is a no-op.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Realtime (Pusher Channels — Vercel Marketplace → "Pusher Channels")
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Optional: File-Uploads (Vercel Blob — Vercel Storage → "Blob")
BLOB_READ_WRITE_TOKEN=

# Optional: Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs)
# Add the following Authorized redirect URIs to the OAuth client:
#   http://localhost:3000/api/auth/google/callback   (dev)
#   https://ctrlk.de/api/auth/google/callback        (prod)
# Without these, the "Mit Google fortfahren" button shows a friendly error.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Seed script (optional, only for db:seed)
# SEED_OWNER_ID=usr_xxx
# SEED_OWNER_EMAIL=you@example.com
# SEED_OWNER_NAME=Your Name
